genesis 0.2.0
module app.section13.brane_provenance {
  use genesis.std.atomic.blank::geo as source : GEOMETRIC<CLOSED,UNBOUND>
  usefn genesis.std.brane.callables::lift_geometric as lift_geo
  usefn genesis.std.provenance.callables::seal_resource as seal_value
  call lift_geo<GEOMETRIC<CLOSED,UNBOUND>> (source) as projection
  call seal_value<M5> (projection) as receipt
  export projection : M5
  export receipt : RECEIPT<PROVENANCE>
}
