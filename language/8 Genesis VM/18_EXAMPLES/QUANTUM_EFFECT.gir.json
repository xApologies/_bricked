        "reference_seed": "GENESIS-SECTION08"
      },
      "id": "07_measure",
      "op": "Q_MEASURE",
      "out": "%qr",
      "type": "QRESULT"
    },
    {
      "args": [
        "%qr"
      ],
      "attrs": {
        "effect": "measurement"
      },
      "id": "08_seal",
      "op": "PROVENANCE_SEAL",
      "out": "%seal",
      "type": "RECEIPT"
    },
    {
      "id": "09_receipt",
      "op": "EMIT_RECEIPT",
      "out": "%receipt",
      "type": "RECEIPT"
