  "properties": {
    "barriers": {
      "type": "object"
    },
    "kind": {
      "const": "GENESIS_OPTIMIZATION_RECEIPT"
    },
    "level": {
      "enum": [
        "O0",
        "OAUDIT",
        "O1"
      ]
    },
    "optimization_id": {
      "type": "string"
    }
