{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "authorities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "genesis.authority-registry.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authorities": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "class"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "canonical_source",
              "canonical_source_and_reference_realization",
              "canonical_navigation_architecture",
              "provenance_history",
              "game_development"
            ]
          }
        }
      }
    }
  }
}
